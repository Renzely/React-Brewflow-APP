{
  "expo": {
    "name": "BrewFlow",
    "slug": "BrewFlow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Engkanto_notxt.png",
    "scheme": "brewflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Engkanto_notxt.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bmp.BrewFlow"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Engkanto.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fe94291-741f-4937-97bc-cdc7f726a153"
      }
    },
    "owner": "harold16"
  }
}
